{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Estado de los Servicios (UP=1 / DOWN=0)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=~\"menu-service|pedidos-service\"}", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] },
          "mappings": [{ "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "title": "Tasa de Consultas al Menu (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "rate(menu_consultas_total[1m]) * 60", "legendFormat": "Consultas menu/min", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 3,
      "title": "Tasa de Pedidos Confirmados vs Rechazados (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(pedidos_confirmados_total[1m]) * 60", "legendFormat": "Confirmados/min", "refId": "A" },
        { "expr": "rate(pedidos_rechazados_total[1m]) * 60", "legendFormat": "Rechazados/min", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "id": 4,
      "title": "Latencia p95 - Consulta Plato (menu-service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(menu_consulta_plato_duration_seconds_bucket[5m]))", "legendFormat": "p95 (s)", "refId": "A" },
        { "expr": "histogram_quantile(0.50, rate(menu_consulta_plato_duration_seconds_bucket[5m]))", "legendFormat": "p50 (s)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "title": "Timeouts al Menu (acumulado)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 12 },
      "targets": [{ "expr": "pedidos_timeouts_menu_total", "legendFormat": "Timeouts", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Platos Disponibles en Menu (negocio)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 12 },
      "targets": [{ "expr": "menu_platos_disponibles", "legendFormat": "Platos disponibles", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "max": 10,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 4 }] }
        }
      }
    },
    {
      "id": 7,
      "title": "Ingresos Totales (negocio)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "targets": [{ "expr": "pedidos_ingresos_total", "legendFormat": "Ingresos $", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 8,
      "title": "Delay Artificial en Menu (Casuistica 2)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "targets": [{ "expr": "menu_delay_artificial_ms", "legendFormat": "Delay (ms)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 }] }
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["restaurante", "microservicios", "kubernetes"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Restaurante — Dashboard de Monitoreo",
  "uid": "restaurante-dashboard",
  "version": 1
}
